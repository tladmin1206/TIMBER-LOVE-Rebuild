# Copy to .env.local for development, or set these in the Replit deployment's
# secrets for production. Never commit real values.
#
# Nothing here is read at build time, so the site builds without any of it.
# What breaks without them is runtime behaviour, noted per block below.

# ---------------------------------------------------------------------------
# LEAD CAPTURE. At least one durable channel should be configured.
#
# An inquiry is kept if ANY channel keeps it (see lib/leads/capture.ts). With
# none of them set, every submission returns 503 and the lead is lost, so
# treat this block as required before launch, not optional.
# ---------------------------------------------------------------------------

# Email notification (Resend). All three are needed together.
# LEAD_FROM_EMAIL must be on a domain verified in Resend: an unverified sender
# returns 403 and is the most common first-run failure.
RESEND_API_KEY=
LEAD_TO_EMAIL=team@example.com
LEAD_FROM_EMAIL=website@yourdomain.com

# HubSpot (Private App access token).
# HubSpot > Settings > Integrations > Private Apps. Scopes needed:
#   crm.objects.contacts.read, crm.objects.contacts.write
# Notes are written through the contacts association, so no extra scope.
HUBSPOT_ACCESS_TOKEN=

# Postgres. Optional: when unset the app runs and leads still go to email and
# HubSpot, it just skips the Inquiry row. Set it to get the recovery queue
# (Inquiry.notified = false) that survives a provider outage.
# After setting it for the first time, run: npx prisma db push
DATABASE_URL=

# ---------------------------------------------------------------------------
# ADMIN (/admin, internal estimator)
# ---------------------------------------------------------------------------

# Required for admin login to work at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the admin session cookie. Set this SEPARATELY in production: it falls
# back to ADMIN_PASSWORD, which makes the password double as the signing key,
# and rotating the password then invalidates every live session.
# Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Property data enrichment for the planner. Unset means the planner falls back
# to manual entry rather than failing.
ATTOM_API_KEY=

# Pricing basis for the planner. Unset keeps the calibrated segment bands.
# Set to `assembly` to drive homeowner figures from the line-item build-up
# instead. Ships dark on purpose: see lib/planner/ruleset.ts.
# PRICING_BASIS=assembly

# Shows planner output labelled as placeholder pricing before sign-off.
# PLANNER_PREVIEW=1

# Analytics IDs. The live values are the defaults in components/Analytics.tsx,
# so these only need setting to point at a different property.
# NEXT_PUBLIC_GOOGLE_TAG_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=
